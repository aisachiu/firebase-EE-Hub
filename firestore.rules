rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function staffPath(email) {
      return /databases/$(database)/documents/staffUsers/$(email);
    }

    function coordinatorDoc(email) {
      return get(staffPath(email)).data;
    }

    function coordinatorFlag(data) {
      return data.isCoordinator == true || data.isAdmin == true;
    }

    function hodFlag(data) {
      return data.isHOD == true;
    }

    // Allocation listeners are read-only. Mutations stay on Cloud Functions (admin SDK).
    function isCoordinator() {
      return signedIn()
        && exists(staffPath(request.auth.token.email.lower()))
        && coordinatorFlag(coordinatorDoc(request.auth.token.email.lower()));
    }

    function isHOD() {
      return signedIn()
        && exists(staffPath(request.auth.token.email.lower()))
        && hodFlag(coordinatorDoc(request.auth.token.email.lower()));
    }

    function allocationReader() {
      return isCoordinator() || isHOD();
    }

    match /staffUsers/{email} {
      allow read: if allocationReader();
      allow write: if false;
    }

    match /subjects/{subjectId} {
      allow read: if allocationReader();
      allow write: if false;
    }

    match /cohorts/{cohortId} {
      allow read: if allocationReader();
      allow write: if false;

      match /members/{memberId} {
        allow read: if allocationReader();
        allow write: if false;
      }

      match /allocationWorkspace/{studentId} {
        allow read: if allocationReader();
        allow write: if false;
      }

      match /supervisorTokens/{tokenId} {
        allow read: if allocationReader();
        allow write: if false;
      }

      match /allocationConfig/{docId} {
        allow read: if allocationReader();
        allow write: if false;
      }

      match /allocationAuditLogs/{logId} {
        allow read: if isCoordinator();
        allow write: if false;
      }
    }

    // Maintenance mode and the daily-job switches. Any signed-in client may
    // listen so the app can redirect before painting a page. Writes stay on
    // Cloud Functions, which check coordinator access and the note length.
    // The document stores no email addresses.
    match /settings/server {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
